<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0F0F0F" />
            <size
                android:width="48dp"
                android:height="48dp" />
        </shape>
    </item>
