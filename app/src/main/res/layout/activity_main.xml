<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/epg_background"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="16dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <!-- Top detail panel -->
    <LinearLayout
        android:id="@+id/detailPanel"
        android:layout_width="match_parent"
        android:layout_height="@dimen/detail_panel_height"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/badgeRecast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_pill"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text="@string/recast_badge"
            android:textColor="@color/epg_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/detailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/epg_text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="Evening News" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/detailTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/epg_text_secondary"
                android:textSize="14sp"
                tools:text="11:00 AM–11:30 AM" />

            <TextView
                android:id="@+id/detailRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_rating_box"
                android:paddingStart="6dp"
                android:paddingTop="1dp"
                android:paddingEnd="6dp"
                android:paddingBottom="1dp"
                android:textColor="@color/epg_text_primary"
                android:textSize="11sp"
                tools:text="TV-PG" />

            <TextView
                android:id="@+id/detailHd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_rating_box"
                android:paddingStart="6dp"
                android:paddingTop="1dp"
                android:paddingEnd="6dp"
                android:paddingBottom="1dp"
                android:text="@string/hd_badge"
                android:textColor="@color/epg_text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/detailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/epg_text_secondary"
            android:textSize="14sp"
            tools:text="Local and national news coverage." />

        <TextView
            android:id="@+id/detailWatchOn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/epg_accent_blue"
            android:textSize="13sp"
            tools:text="Watch on Fire TV Recast | PBS" />
    </LinearLayout>

    <!-- Filter pills -->
    <HorizontalScrollView
        android:id="@+id/filterScroll"
        android:layout_width="match_parent"
        android:layout_height="@dimen/filter_bar_height"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/filterBar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Action row: Ch − / Ch + / Record -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnChannelDown"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_filter_selected"
            android:focusable="true"
            android:minWidth="100dp"
            android:text="@string/channel_down"
            android:textAllCaps="false"
            android:textColor="@color/epg_text_on_focus" />

        <Button
            android:id="@+id/btnChannelUp"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_filter_selected"
            android:focusable="true"
            android:minWidth="100dp"
            android:text="@string/channel_up"
            android:textAllCaps="false"
            android:textColor="@color/epg_text_on_focus" />

        <Button
            android:id="@+id/btnRecord"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_filter_outline"
            android:focusable="true"
            android:minWidth="100dp"
            android:text="@string/record"
            android:textAllCaps="false"
            android:textColor="@color/epg_text_primary" />
    </LinearLayout>

    <!-- EPG grid host -->
    <com.nickora.firetv.channelguide.ui.EpgGuideView
        android:id="@+id/epgGuide"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:focusable="true"
        android:focusableInTouchMode="true" />
</LinearLayout>
